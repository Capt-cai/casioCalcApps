#!/usr/bin/env python3
import json,subprocess,sys
from pathlib import Path
from urllib.parse import urlparse
root=Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip())
p=json.loads((root/'tools/versioning/remote-policy.json').read_text())
remote,url=sys.argv[1:3]
if url.startswith('git@github.com:'):repo=url.split(':',1)[1]
else:
 parsed=urlparse(url);repo=parsed.path.lstrip('/') if parsed.hostname=='github.com' and parsed.scheme in ('https','ssh') else ''
repo=repo.removesuffix('.git').lower()
if remote!=p['personal_remote'] or repo!=p['personal_repository'].lower():sys.exit('Blocked: only verified personal origin is authorized; upstream push is forbidden.')
zero='0'*40
for line in sys.stdin:
 local_ref,local_sha,remote_ref,remote_sha=line.split()
 if local_sha==zero:sys.exit('Blocked: deleting remote refs is not authorized.')
 if remote_sha==zero or local_sha==remote_sha:continue
 if remote_ref.startswith('refs/tags/'):sys.exit('Blocked: replacing an existing tag is not authorized.')
 if subprocess.run(['git','merge-base','--is-ancestor',remote_sha,local_sha],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode:
  sys.exit('Blocked: non-fast-forward/unknown remote history; fetch and review before pushing.')
